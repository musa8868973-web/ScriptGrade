# ============================================================
# ScriptGrade Backend — environment contract
# Copy to `.env` and fill in real values before running.
# ============================================================

# --- Service -------------------------------------------------
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AnalyticDB for PostgreSQL (pgvector) ---------------------
DATABASE_URL=postgresql+asyncpg://user:password@analyticdb-host:5432/scriptgrade
PGVECTOR_ENABLED=true

# --- OAuth2 / JWT ---------------------------------------------
JWT_SECRET_KEY=your_super_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Celery / Redis --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Alibaba Cloud OSS ------------------------------------------
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=scriptgrade-scans
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
# Optional public/CDN base URL used for stored object links
OSS_PUBLIC_BASE_URL=

# --- Alibaba Cloud DashScope (Qwen-2.5 / Qwen-VL) ----------------
QWEN_API_KEY=your_alibaba_dashscope_api_key
QWEN_LLM_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus
