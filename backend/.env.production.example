# ============================================================
# ScriptGrade Backend — PRODUCTION environment template
# Copy to `.env.production` or set these as Railway service
# variables, then fill in real secret values. NEVER commit the
# populated file (only this `.example` is tracked).
# ============================================================

# --- Database (managed PostgreSQL + pgvector) ------------------
# Railway: attach a PostgreSQL plugin and paste its DSN. The FastAPI
# gateway requires the async driver (postgresql+asyncpg://...).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/scriptgrade
PGVECTOR_ENABLED=true

# --- Redis (Celery broker + result backend) --------------------
REDIS_URL=redis://host:6379/0

# --- CORS -------------------------------------------------------
# Origin(s) of the deployed Vercel frontend. Accepts a comma-separated
# list OR a JSON array (see app/config.py::_parse_cors_origins).
#   CORS_ORIGINS=https://scriptgrade.vercel.app,https://staging.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app

# --- Security / secret key --------------------------------------
# The gateway signs JWTs with JWT_SECRET_KEY. SECRET_KEY is retained as
# the canonical production alias; set BOTH to the SAME long random value
# (generate one with `openssl rand -hex 32`). Leaving JWT_SECRET_KEY at
# its default is a critical security risk.
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Runtime ----------------------------------------------------
# Railway injects PORT automatically; the server binds 0.0.0.0:$PORT
# (see app/main.py __main__ and railway.json startCommand).
DEBUG=false
