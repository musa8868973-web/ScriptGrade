# ============================================================
# ScriptGrade Frontend — PRODUCTION environment template (Vercel)
# Copy to `.env.production` or set these as Vercel environment
# variables. Vite inlines VITE_* values at BUILD time, so trigger a
# redeploy after changing them.
# ============================================================

# Base URL of the deployed Railway backend, INCLUDING the `/api/v1`
# prefix that the axios client appends endpoint paths to. When unset,
# the client falls back to http://localhost:8000/api/v1 (local dev).
VITE_API_BASE_URL=https://your-backend.up.railway.app/api/v1
