# ScriptGrade NLP/AI Engine — environment template
# Copy to `.env` inside nlp-engine/ and fill in real values.

# ------------------------------------------------------------------ #
# Alibaba Cloud DashScope (unified Qwen inference gateway)            #
# ------------------------------------------------------------------ #
QWEN_API_KEY=your_alibaba_dashscope_api_key
QWEN_LLM_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_DIM=1024

# ------------------------------------------------------------------ #
# AnalyticDB for PostgreSQL (pgvector)                                #
# Leave DATABASE_URL empty to fall back to the in-memory vector store #
# ------------------------------------------------------------------ #
DATABASE_URL=postgresql+asyncpg://user:password@analyticdb-host:5432/scriptgrade
PGVECTOR_ENABLED=true
# EMBEDDINGS_TABLE=scriptgrade_embeddings
