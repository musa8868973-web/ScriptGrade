# ---------------------------------------------------------------------------
# ScriptGrade mobile — environment template (README Step 2 contract)
# Copy to `.env` and adjust for your network.
#
#   iOS simulator / Expo web : http://localhost:8000/api/v1
#   Android emulator         : http://10.0.2.2:8000/api/v1  (maps to host)
#   Physical device (LAN)    : http://<your-computer-lan-ip>:8000/api/v1
#
# The backend must be running (uvicorn on port 8000) for login, exam setup,
# paper upload and diagnostics polling.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
